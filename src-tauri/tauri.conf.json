{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaylorChat",
  "version": "0.4.1",
  "identifier": "com.taylor.taylorchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1427",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TaylorChat",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**",
          "$APPDATA/avatars/**",
          "$APPDATA/profile/**",
          "$APPDATA/stickers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": ["binaries/llama/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
